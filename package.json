{
  "name": "quantum-airbag",
  "version": "0.1.0",
  "description": "Crypto-agile PDA vault for post-quantum security",
  "scripts": {
    "test": "anchor test --validator legacy",
    "setup": "ts-node scripts/setup-local.ts",
    "init-registry": "TS_NODE_PROJECT=tsconfig.json ts-node scripts/init-registry.ts",
    "wallet": "ts-node scripts/generate-wallet.ts",
    "sync-id": "ts-node scripts/sync-program-id.ts",
    "demo": "npm --prefix client run demo",
    "threat-api": "npm --prefix threat-api start",
    "sentinel": "npm --prefix sentinel start",
    "ui": "npm --prefix ui run dev",
    "dev": "npx concurrently -n threat-api,sentinel,ui -c cyan,yellow,green \"npm run threat-api\" \"npm run sentinel\" \"npm run ui\""
  },
  "keywords": ["solana", "anchor", "post-quantum", "cryptography"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@solana/web3.js": "^1.95.4"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.0",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^9.0.0",
    "chai": "^4.3.4",
    "mocha": "^9.0.3",
    "ts-mocha": "^10.0.0",
    "typescript": "^4.3.5"
  }
}
